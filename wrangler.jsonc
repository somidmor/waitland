{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "waitland-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "waitland.app",
      "custom_domain": true
    },
    {
      "pattern": "www.waitland.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "REALTIME_ORIGIN": "https://realtime.waitland.app"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "images": {
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.01
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
