{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/index.ts",
    "src/domain.ts",
    "src/ids.ts",
    "src/sharding.ts",
    "src/tokens.ts",
    "src/types.ts",
    "../shared/world.ts"
  ],
  "exclude": ["src/cloudflare.d.ts"]
}
